{
	"info": {
		"_postman_id": "6f1c2a9e-3b7d-4f5e-9a1b-2c3d4e5f6a7b",
		"name": "Shop API",
		"description": "Orders and customers for the demo shop.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "1234567"
	},
	"item": [
		{
			"name": "Orders",
			"item": [
				{
					"name": "List orders",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": ["pm.test(\"200\", () => pm.response.to.have.status(200));"],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "text" },
							{ "key": "X-Debug", "value": "1", "type": "text", "disabled": true }
						],
						"url": {
							"raw": "{{baseUrl}}/orders?status=open&page=1",
							"host": ["{{baseUrl}}"],
							"path": ["orders"],
							"query": [
								{ "key": "status", "value": "open" },
								{ "key": "page", "value": "1" },
								{ "key": "sort", "value": "-created", "disabled": true }
							]
						}
					},
					"response": []
				},
				{
					"name": "Get order",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/orders/:orderId",
							"host": ["{{baseUrl}}"],
							"path": ["orders", ":orderId"],
							"variable": [{ "key": "orderId", "value": "42" }]
						}
					},
					"response": []
				},
				{
					"name": "Create order",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"sku\": \"BEE-1\",\n    \"quantity\": 2\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": ["{{baseUrl}}"],
							"path": ["orders"]
						}
					},
					"response": []
				},
				{
					"name": "Upload receipt",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [{ "key": "file", "type": "file", "src": "/tmp/receipt.pdf" }]
						},
						"url": {
							"raw": "{{baseUrl}}/orders/42/receipt",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "42", "receipt"]
						}
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [{ "key": "token", "value": "{{orderToken}}", "type": "string" }]
			}
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Log in",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "username", "value": "bee", "type": "text" },
								{ "key": "password", "value": "{{password}}", "type": "text" },
								{ "key": "remember", "value": "true", "type": "text", "disabled": true }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": ["{{baseUrl}}"],
							"path": ["login"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Health",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/health",
					"host": ["{{baseUrl}}"],
					"path": ["health"]
				}
			},
			"response": []
		}
	],
	"auth": {
		"type": "basic",
		"basic": [
			{ "key": "password", "value": "{{password}}", "type": "string" },
			{ "key": "username", "value": "admin", "type": "string" }
		]
	},
	"variable": [{ "key": "baseUrl", "value": "https://shop.example.test/api" }]
}
